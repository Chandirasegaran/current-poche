<?xml version="1.0" encoding="utf-8"?>
<!-- Windows MSI for Current Pochu! The file list (files.wxs) is generated by Packaging/build.sh. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Current Pochu!" Language="1033" Version="$(var.VERSION)" Manufacturer="Segar Games"
           UpgradeCode="6f0d8a52-3b1e-4c47-9a6d-2e5c7b9f1a30">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine"/>
    <Media Id="1" Cabinet="game.cab" EmbedCab="yes"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Current Pochu"/>
      </Directory>
      <Directory Id="ProgramMenuFolder"/>
    </Directory>
    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="b7a4c1d9-52e8-4f60-8c3a-91d2e6f4a7b5" Win64="yes">
        <Shortcut Id="GameShortcut" Name="Current Pochu!" Target="[INSTALLDIR]CurrentPochu.exe" WorkingDirectory="INSTALLDIR"/>
        <RegistryValue Root="HKCU" Key="Software\SegarGames\CurrentPochu" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>
    <Feature Id="Main" Level="1">
      <ComponentGroupRef Id="AppFiles"/>
      <ComponentRef Id="StartMenuShortcut"/>
    </Feature>
  </Product>
</Wix>
